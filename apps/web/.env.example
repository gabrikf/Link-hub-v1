# =============================================================================
# apps/web — environment reference
# =============================================================================
#
# Copy to `apps/web/.env` for local development. Gitignored; placeholders only.
#
# -----------------------------------------------------------------------------
# THESE ARE BUILD-TIME VALUES, NOT RUNTIME VALUES
# -----------------------------------------------------------------------------
# Vite does not read environment variables at runtime — it TEXTUALLY SUBSTITUTES
# every `import.meta.env.VITE_*` into the bundle when `vite build` runs. Two
# consequences that catch people out:
#
#   1. The Cloudflare Pages BUILD needs these variables (Pages project →
#      Settings → Environment variables), not the deployed site. Changing one in
#      the dashboard does nothing until the next build; you must redeploy.
#
#   2. EVERY VALUE HERE SHIPS TO THE BROWSER IN PLAIN TEXT. There is no such
#      thing as a secret in this file. VITE_GOOGLE_CLIENT_ID is a public OAuth
#      client id, which is fine. Never add an API key, a client SECRET, or
#      anything from apps/api/.env.example — the `VITE_` prefix is the only
#      thing standing between a variable and public disclosure, and it is a
#      naming convention, not a protection.
#
# Only variables prefixed `VITE_` are exposed at all; anything else in the
# environment is ignored by the client bundle.


# Base URL of the LinkHub API, no trailing slash.
# [required] The origin set here must also appear in the API's WEB_APP_URL
# allow-list or every request fails CORS.
# Local  : http://localhost:3333
# Prod   : https://api.example.com
VITE_API_URL=http://localhost:3333

# Google OAuth client id used by the sign-in button.
# [required] for Google sign-in. Must be the SAME client id as the API's
# GOOGLE_CLIENT_ID — a mismatch fails token verification with an audience error
# that looks nothing like a configuration problem.
# Public by design; this is the client id, never the client secret.
VITE_GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Base URL the TensorFlow.js model files are fetched from (e.g. an R2 public
# bucket or a CloudFront distribution).
# [optional] Leave empty to serve the models from the same origin as the app,
# which is the default for local development.
# Example: VITE_MODEL_CDN_BASE_URL=https://d1234abcd.cloudfront.net
VITE_MODEL_CDN_BASE_URL=

# -----------------------------------------------------------------------------
# Sentry (browser)
# -----------------------------------------------------------------------------
# Opt-in: with no DSN the SDK is never initialised and nothing is sent.
# [prod-only]

# Front-end project DSN — a DIFFERENT project from the API's SENTRY_DSN, so
# browser noise does not drown out server errors. A Sentry DSN is public by
# design and safe to ship in a bundle.
VITE_SENTRY_DSN=

# Environment tag on every event: production | preview | development.
# On Cloudflare Pages, set it to "preview" for the preview branch environment so
# branch deploys do not pollute production issues.
VITE_SENTRY_ENVIRONMENT=production

# Release identifier, used to attribute a regression to a deploy. Use the commit
# SHA. On Cloudflare Pages that is available at build time as CF_PAGES_COMMIT_SHA,
# so the build command can be:
#   VITE_SENTRY_RELEASE=$CF_PAGES_COMMIT_SHA npm run build:web
# It must match the release name used when source maps are uploaded, or stack
# traces stay minified.
VITE_SENTRY_RELEASE=
