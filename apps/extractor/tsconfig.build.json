{
  // The shipping surface, with `*.test.ts` and the test helpers excluded. The
  // published package is a set of esbuild bundles, so nothing here is emitted —
  // `npm run build` points `tsc --noEmit` at this file so the code that
  // actually goes into the tarball is type-checked before it is bundled, and a
  // test-only type error can never block a publish. Type CHECKING for
  // development still uses the plain `tsconfig.json`, which includes the tests
  // — `npm run check-types` must cover them or the privacy assertions could rot
  // untyped.
  "extends": "./tsconfig.json",
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "src/test-support.ts"]
}
