# =============================================================================
# apps/api — environment reference
# =============================================================================
#
# Copy to `apps/api/.env` for local development, or to `.env.production` at the
# repo root for the Docker Compose stack. Both are gitignored and MUST stay that
# way. Every value below is a placeholder — never commit a real secret here.
#
# -----------------------------------------------------------------------------
# HOW TO READ THIS FILE
# -----------------------------------------------------------------------------
# Each variable is tagged:
#
#   [required]      the API refuses to start (or the feature hard-fails) without it
#   [prod-only]     only meaningful in production; leave unset locally
#   [optional]      has a working default, set it to tune behaviour
#
# LEAVING EVERY VARIABLE IN THIS FILE UNSET IS A VALID LOCAL-DEVELOPMENT SETUP,
# with two exceptions: DATABASE_URL, and OPENAI_API_KEY if you are working on
# the AI features. Everything else degrades to a permissive local default —
# rate limiting is effectively off, AI quotas are off, telemetry and Sentry are
# off and cost nothing, logging is human-readable. That is deliberate: adding a
# variable must never break `npm run dev`.
#
# In PRODUCTION (NODE_ENV=production) the API additionally refuses to boot
# without JWT_SECRET, WEB_APP_URL, DATABASE_URL, REDIS_URL and a real mail
# transport (SMTP_HOST) — see assertProductionConfig()
# in src/infra/config/app-config.ts. Their fallbacks are a forgeable session
# token and a CORS policy pointing at localhost, which are vulnerabilities
# rather than inconveniences.
#
# Vite bakes the front end's own variables in at BUILD time; those live in
# apps/web/.env.example, not here.


# =============================================================================
# RUNTIME
# =============================================================================

# "production" | "development" | "test". Switches on JSON logging, the
# production config assertions, AI quotas, the production rate limit, and hides
# the Swagger UI at /docs.
# [prod-only] The Docker image already sets it to production.
NODE_ENV=development

# TCP port the HTTP server binds. Default 3333.
# [optional] Fixed at 3333 inside the container; change the compose port mapping
# instead of this if you need a different external port.
PORT=3333

# Bind address. Default 0.0.0.0.
# [optional] Must stay 0.0.0.0 in the container — 127.0.0.1 would make the
# service unreachable from Caddy and from the Docker healthcheck.
HOST=0.0.0.0

# pino level: trace|debug|info|warn|error|fatal. Default "info".
# [prod-only] Ignored outside production, where the logger is switched off
# entirely so `tsx watch` output stays readable.
LOG_LEVEL=info

# Which of the three containers this process is: api | worker-embedding |
# worker-digest. Default "api".
# [prod-only] It decides which process reports the once-per-cluster gauges (DAU,
# queue depth). Exactly ONE container may be `api`, or those metrics are counted
# three times. docker-compose.prod.yml sets it per service; do not put it in
# .env.production.
# SERVICE_ROLE=api


# =============================================================================
# DATABASE
# =============================================================================

# postgres:// connection string. Requires the pgvector extension.
# [required] everywhere.
# Local  : postgresql://crafthub_user:crafthub_password@localhost:5432/crafthub_dev
# Compose: the host is the service name `postgres`, not localhost.
DATABASE_URL=postgresql://crafthub_user:crafthub_password@postgres:5432/crafthub

# Credentials for the postgres CONTAINER (docker-compose.prod.yml and
# scripts/backup.sh read these). They must agree with DATABASE_URL above.
# [prod-only]
POSTGRES_DB=crafthub
POSTGRES_USER=crafthub_user
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Max connections in this process's pool. Default 20.
# [optional] On the 4GB VPS three containers each open a pool, so the real
# demand is 3x this value against postgres's max_connections=80. Do not raise it
# without raising max_connections in docker-compose.prod.yml.
DATABASE_POOL_MAX=20

# Seconds an idle pooled connection is kept. Default 30.
# [optional]
DATABASE_IDLE_TIMEOUT_SECONDS=30

# Seconds to wait for a new connection before failing. Default 10.
# [optional]
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Seconds after which a connection is recycled regardless of use. Default 1800.
# [optional] Keeps long-lived pools from pinning a stale backend across a
# postgres restart.
DATABASE_MAX_LIFETIME_SECONDS=1800


# =============================================================================
# REDIS  (BullMQ queues, rate-limit counters, AI quota counters)
# =============================================================================

# redis:// connection string. Default redis://127.0.0.1:6379.
# [required in production] Without it the queues have nowhere to run, the rate
# limiter falls back to a per-container in-memory store (so each replica allows
# the full budget independently) and AI quotas switch off entirely.
# Compose: redis://redis:6379
REDIS_URL=redis://redis:6379


# =============================================================================
# AUTH
# =============================================================================

# Signing key for access and refresh tokens.
# [required in production] The API refuses to boot without it. Generate with:
#   openssl rand -base64 48
# Rotating it invalidates every existing session.
JWT_SECRET=generate-me-openssl-rand-base64-48

# Access-token lifetime, e.g. "15m", "1h". Default "15m".
# [optional] Short on purpose — the refresh token is what keeps a user signed in.
JWT_EXPIRES_IN=15m

# Google OAuth client id (the public one, also set as VITE_GOOGLE_CLIENT_ID in
# the web app — the two must match or sign-in fails with an audience error).
# [required in production] if Google sign-in is enabled.
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# LinkedIn OAuth application credentials.
# [required in production] if LinkedIn sign-in is enabled. LINKEDIN_REDIRECT_URI
# has no default and throws at container start-up when the LinkedIn provider is
# constructed; it must match the callback registered in the LinkedIn app exactly,
# including scheme and trailing path.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://api.example.com/auth/linkedin/callback

# Comma-separated list of origins allowed by CORS. No trailing slashes.
# [required in production] The API refuses to boot without it, because the
# fallback is the localhost Vite ports and the deployed front end could not
# reach the API. Include every origin that calls this API: the Pages domain, any
# custom domain, and a preview URL if you use one.
# Local: unset — http://localhost:5173 and :4173 are allowed automatically.
WEB_APP_URL=https://app.example.com,https://www.example.com

# The ONE canonical origin used to build links that go into emails.
# [optional] Defaults to the FIRST entry of WEB_APP_URL, and to
# http://localhost:5173 when that is unset too.
#
# Not a duplicate of WEB_APP_URL: that is a comma-separated CORS ALLOW-LIST and
# can legitimately hold three origins (the Pages domain, a custom domain, a
# preview URL). A verification link has to pick exactly one, and silently
# picking "whichever the operator happened to list first" is the kind of default
# that sends every user to the staging domain. Set this explicitly in
# production; the fallback exists so nothing new is required to boot.
APP_PUBLIC_URL=https://app.example.com


# =============================================================================
# EMAIL  (verification links)
# =============================================================================
# Two flows send mail: signup verification and password reset. A password signup
# creates an UNVERIFIED account and emails a link; the account cannot sign in
# until that link is opened. OAuth accounts are verified by construction and
# never touch verification. Both flows are dead without a working transport.

# Which mail implementation runs: "smtp" | "log".
# [optional] Defaults to "smtp" when SMTP_HOST is set, "log" otherwise.
#
# "log" is NOT a stub — it is the supported development transport. It prints the
# whole email, including the verification URL, to the API's terminal, so the
# entire flow works locally with nothing configured. In PRODUCTION the API
# refuses to boot on this transport: verification mail written to a container
# log means nobody can ever confirm an account, and every signup dead-ends at
# "check your inbox".
MAIL_TRANSPORT=smtp

# SMTP server. SMTP_HOST is what switches the transport on.
# [required in production] Without a host the API refuses to boot.
# Port 587 (the default) is submission and upgrades via STARTTLS, so
# SMTP_SECURE stays false; use SMTP_SECURE=true together with SMTP_PORT=465.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false

# Credentials. [optional] Leave both unset for a relay that accepts
# unauthenticated submission (MailHog/Mailpit locally, some internal smarthosts).
# TREAT SMTP_PASSWORD AS A SECRET.
SMTP_USER=
SMTP_PASSWORD=

# RFC 5322 From header on every outbound email.
# [optional] Default "CraftHub <no-reply@localhost>", which is fine for the log
# transport and will be rejected or spam-filed by any real receiver — set a
# real address on a domain with SPF/DKIM in production.
MAIL_FROM=CraftHub <no-reply@example.com>

# How long an emailed verification link stays usable, in hours. Default 24.
# [optional] Long enough to survive "I'll do it tonight", short enough that a
# forwarded link or one left in a shared inbox stops working.
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24

# How long an emailed PASSWORD RESET link stays usable, in minutes. Default 20.
# [optional] Minutes, not hours, and much shorter than the verification TTL on
# purpose: a reset token IS the account, so OWASP puts the ceiling at 20
# minutes. Raising this widens the window in which a forwarded or intercepted
# email is a full account takeover.
PASSWORD_RESET_TOKEN_TTL_MINUTES=20

# Fixed time POST /auth/forgot-password and POST /auth/resend-verification take
# to answer, in milliseconds. Default 500.
# [optional] This is a security control, not a tuning knob. Both endpoints
# answer 200 { status: "sent" } for a registered address and an unknown one
# alike — but the registered one costs a token, a database row and an SMTP send,
# and without this floor it answered measurably slower, which is an
# account-existence oracle a stopwatch reads on the first probe. Lowering this
# re-opens that gap in proportion; 0 turns the control off entirely.
AUTH_EMAIL_RESPONSE_FLOOR_MS=500


# =============================================================================
# ABUSE LIMITS
# =============================================================================

# Master switch for @fastify/rate-limit. Default true.
# [optional] Turn it off only to reproduce a bug.
RATE_LIMIT_ENABLED=true

# Requests per window per client. Default 100 in production, 100000 otherwise —
# a production-shaped limit locally would 429 on Vite's dev server plus React
# StrictMode double-invocation and look like a broken feature.
# [prod-only]
RATE_LIMIT_MAX=100

# Window length in milliseconds. Default 60000.
# [optional]
RATE_LIMIT_WINDOW_MS=60000

# Per-user, per-day caps on the two routes that spend OpenAI credits. Enabled by
# default in production only, and inert without Redis (there is nowhere to count).
# [prod-only] These are the difference between a bounded and an unbounded
# OpenAI bill.
AI_QUOTA_ENABLED=true
AI_QUOTA_RESUME_PARSE_DAILY=5
AI_QUOTA_RECRUITER_SEARCH_DAILY=30


# =============================================================================
# FILE STORAGE  (Cloudflare R2, S3-compatible)
# =============================================================================
# All six are read together: if any is missing the storage provider fails to
# construct and every upload route errors. [required in production]

# R2 S3 API endpoint: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com

# R2 has no regions; "auto" is correct and is the default when unset.
S3_REGION=auto

# Bucket that holds avatars, cover images and resumes.
S3_BUCKET=crafthub-media

# R2 API token pair, scoped to that bucket. Use a DIFFERENT token from the
# backup job's (see scripts/backup.sh).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Public base URL the stored objects are served from — the R2 public bucket URL
# or the custom domain in front of it. This is what ends up in the img src the
# browser loads, so it must be publicly reachable, not the S3 endpoint above.
S3_PUBLIC_BASE_URL=https://media.example.com

# Server-side resize/re-encode with sharp before upload. Default enabled.
# [optional] Switching it off means storing whatever the user uploaded, at full
# resolution, and paying R2 egress for it.
IMAGE_OPTIMIZATION_ENABLED=true

# Longest edge in pixels after resize. Default 1600.
# [optional]
IMAGE_MAX_DIMENSION=1600

# Output quality, 1-100. Default 82.
# [optional]
IMAGE_QUALITY=82


# =============================================================================
# OPENAI  (resume parsing, recruiter query conversion, embeddings)
# =============================================================================

# API key. [required] for every AI feature; without it those routes fail and the
# rest of the app works.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx

# Request timeout in ms for embeddings and query conversion. Default 15000.
# [optional]
OPENAI_TIMEOUT_MS=15000

# Request timeout in ms for resume parsing specifically. Default 60000 — parsing
# a long PDF is a much bigger completion than the calls above.
# [optional]
OPENAI_PARSE_TIMEOUT_MS=60000

# SDK-level retries on 429/5xx. Default 2.
# [optional]
OPENAI_MAX_RETRIES=2

# Model used to turn an uploaded resume into structured JSON. Default gpt-4o-mini.
# [optional]
RESUME_PARSING_MODEL=gpt-4o-mini

# Model used to turn a recruiter's plain-English query into search filters.
# Default gpt-4o-mini.
# [optional]
QUERY_CONVERSION_MODEL=gpt-4o-mini


# =============================================================================
# EMBEDDINGS AND VECTOR SEARCH
# =============================================================================

# Embedding model. Default text-embedding-3-small.
# [optional] CHANGING THIS INVALIDATES EVERY STORED VECTOR — a new model's
# vectors are not comparable with the old ones. Bump EMBEDDING_VERSION with it
# and re-embed.
EMBEDDING_MODEL=text-embedding-3-small

# Integer stamped on each stored embedding. Default 1.
# [optional] Bump it to force a re-embed after changing the model or the text
# that gets embedded.
EMBEDDING_VERSION=1

# In-process cache of query embeddings. Defaults: 86400s TTL, 10000 items.
# [optional] Lower EMBEDDING_CACHE_MAX_ITEMS if the api container is close to
# its 768MB limit — 10000 vectors is real memory.
EMBEDDING_CACHE_TTL_SECONDS=86400
EMBEDDING_CACHE_MAX_ITEMS=10000

# Minimum cosine similarity for a resume search hit, 0-1. Default 0.1.
# [optional] Raise it for fewer, more relevant results.
SEARCH_MIN_SIMILARITY=0.1

# ivfflat lists probed per query. Default 10.
# [optional] Higher = better recall, slower query. The classic pgvector tuning
# knob; leave it alone until search quality is actually a complaint.
IVFFLAT_PROBES=10

# BullMQ concurrency for each worker. Default 4 each.
# [optional] On the 4GB box these are the two knobs that decide how much memory
# the workers use under load. Embedding jobs hold parsed resume text plus float
# vectors at once, so raising the first one is the fastest way to OOM-kill that
# container.
RESUME_EMBEDDING_WORKER_CONCURRENCY=4
ACTIVITY_DIGEST_WORKER_CONCURRENCY=4


# =============================================================================
# OBSERVABILITY — Sentry
# =============================================================================
# Entirely opt-in: with no SENTRY_DSN the SDK is never initialised and costs
# nothing. [prod-only]

# Project DSN. Setting it is what turns Sentry on.
SENTRY_DSN=

# Environment tag on every event. Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=production

# Release identifier, used to attribute a regression to a deploy. Defaults to
# GIT_SHA when unset. Must match the value used when source maps are uploaded.
SENTRY_RELEASE=

# Fraction of transactions traced, 0-1. Default 0 (errors only).
# LEAVE THIS AT 0. sentry.ts omits the option entirely when it is 0, because
# Sentry v10 treats "defined" as "tracing enabled" and would then install its
# own http/fastify/pg/ioredis instrumentation on top of OpenTelemetry's —
# duplicate spans and a second TracerProvider, on a 4GB box, for no extra
# insight. OpenTelemetry is the tracer here; Sentry is the error sink.
# This line used to say 0.1, which would have quietly enabled exactly that.
SENTRY_TRACES_SAMPLE_RATE=0


# =============================================================================
# OBSERVABILITY — OpenTelemetry / Grafana Cloud
# =============================================================================
# Also entirely opt-in, and gated on the ENDPOINT alone: unset it and no SDK, no
# exporter, no cost and — importantly — no error. [prod-only]

# OTLP/HTTP endpoint. Its presence is the on switch for all telemetry.
# Grafana Cloud: https://otlp-gateway-<region>.grafana.net/otlp
OTEL_EXPORTER_OTLP_ENDPOINT=

# Extra OTLP headers, comma-separated key=value. For Grafana Cloud this carries
# the basic-auth credential:
#   Authorization=Basic <base64 of "instanceID:apiToken">
# TREAT AS A SECRET.
OTEL_EXPORTER_OTLP_HEADERS=

# OpenTelemetry ESM loader hook. DEFAULT false, and the default is deliberate.
# Setting it to "true" makes register.ts install import-in-the-middle, which
# intercepts EVERY ESM import in the process. openai@4 resolves its runtime
# through the _shims subsystem at module-evaluation time and throws under that
# interception, taking the API down in a boot crash-loop. It cost six minutes of
# production 503 on 2026-08-29, on openai@4. Turning it on buys distributed
# traces and nothing else — every dashboard metric is recorded by hand in
# metrics.ts.
# This repo is now on openai@7, which deleted _shims, and the import no longer
# throws under the hook. Leave it false until telemetry is confirmed working in
# production, then flip it ALONE so a failure has exactly one candidate cause.
OTEL_ESM_LOADER_HOOK=false

# service.name / service.namespace on every span, metric and log.
# Defaults: crafthub-api, crafthub.
OTEL_SERVICE_NAME=crafthub-api
OTEL_SERVICE_NAMESPACE=crafthub

# Metric push interval in ms. Default 60000.
# Lowering it multiplies the series volume you are billed for.
OTEL_METRIC_EXPORT_INTERVAL_MS=60000

# Grafana Cloud instance id and token. Used to build the OTLP auth header when
# OTEL_EXPORTER_OTLP_HEADERS is not set explicitly.
# TREAT GRAFANA_CLOUD_API_TOKEN AS A SECRET.
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=

# deployment.environment resource attribute. Defaults to NODE_ENV.
# Set it to "staging" on a staging box so one Grafana stack can hold both.
DEPLOYMENT_ENVIRONMENT=production

# Commit SHA of the running build. Used as the Sentry release fallback and as a
# resource attribute, which is what lets you say "this regression started with
# that deploy". scripts/deploy.sh knows the SHA — pass it through if you want it
# stamped on telemetry.
GIT_SHA=


# =============================================================================
# DEPLOYMENT  (read by docker-compose.prod.yml and the Caddyfile, not by the app)
# =============================================================================

# Public hostname Caddy obtains a TLS certificate for and serves the API on.
# [prod-only, required] Its DNS A/AAAA record must already point at this VPS
# before the first start, or the ACME challenge fails.
DOMAIN=api.example.com

# Contact address for the Let's Encrypt account. Expiry and renewal-failure
# warnings go here.
# [prod-only]
ACME_EMAIL=ops@example.com
