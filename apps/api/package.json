    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@repo/schemas": "*",
    "@sentry/node": "^10.70.0",
    "argon2": "^0.44.0",
    "bullmq": "^5.58.3",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.44.4",
    "fastify": "^5.5.0",
    "fastify-plugin": "^6.0.0",
    "fastify-type-provider-zod": "^6.0.0",
    "google-auth-library": "^10.6.2",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.1",
    "nodemailer": "^9.0.6",
    "openai": "^4.104.0",
