{
  "name": "api",
  "version": "1.0.0",
  "description": "This is the api main service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/infra/queue/run-resume-embedding-worker.ts",
    "dev:digest-worker": "tsx watch src/infra/queue/run-activity-digest-worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "start": "node --import ./dist/infra/observability/register.js dist/index.js",
    "start:worker": "node --import ./dist/infra/observability/register.js dist/infra/queue/run-resume-embedding-worker.js",
    "start:digest-worker": "node --import ./dist/infra/observability/register.js dist/infra/queue/run-activity-digest-worker.js",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "drizzle-kit": "drizzle-kit",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/infra/database/drizzle/migrate.js",
    "db:seed": "tsx src/infra/database/drizzle/seed.ts",
    "db:seed:real": "tsx src/infra/database/drizzle/seed-realistic.ts",
    "db:seed:all": "npm run db:seed && npm run db:seed:real",
    "migrate:dev": "drizzle-kit generate && drizzle-kit migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "pg": "^8.16.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.57.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.859.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.2.1",
    "@fastify/oauth2": "^8.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/instrumentation": "^0.221.0",
    "@opentelemetry/instrumentation-fastify": "^0.57.0",
    "@opentelemetry/instrumentation-http": "^0.221.0",
    "@opentelemetry/instrumentation-ioredis": "^0.69.0",
    "@opentelemetry/instrumentation-pg": "^0.73.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.34.0",
    "@opentelemetry/instrumentation-undici": "^0.31.0",
