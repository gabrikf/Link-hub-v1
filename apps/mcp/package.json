{
  "name": "crafthub-mcp",
  "version": "1.0.0",
  "description": "CraftHub MCP server — create and manage CraftHub posts from any MCP client (Claude Desktop, Claude Code, Cursor, VS Code).",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "crafthub-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://crafthub.dev",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --external:zod --external:@modelcontextprotocol/sdk --outfile=dist/index.js --watch",
    "build": "tsc --noEmit -p tsconfig.build.json && rm -rf dist && esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --external:@modelcontextprotocol/sdk --external:zod --outfile=dist/index.js && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build",
    "lint": "eslint ."
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "crafthub"
  ],
  "author": "gabrikf",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.1.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/schemas": "*",
    "@repo/typescript-config": "*",
    "@types/node": "^24.3.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.39.4",
    "tsx": "^4.20.5",
    "typescript": "5.9.2"
  }
}
