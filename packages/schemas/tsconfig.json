{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  // Tests are compiled by vitest, never shipped: emitting them into `dist`
  // would also drag `vitest` into the published type surface, and consumers do
  // not have it installed.
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
