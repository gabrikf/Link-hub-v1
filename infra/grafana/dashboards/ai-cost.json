        "options": [{ "selected": true, "text": "0.60", "value": "0.60" }],
        "query": "0.60",
        "skipUrlSync": false,
        "type": "textbox"
      },
      {
        "current": { "text": "0.02", "value": "0.02" },
        "description": "USD per 1,000,000 tokens for text-embedding-3-small. Embeddings are input-only, so one price covers both directions.",
        "hide": 0,
        "label": "text-embedding-3-small $/1M",
        "name": "price_embed_small",
        "options": [{ "selected": true, "text": "0.02", "value": "0.02" }],
        "query": "0.02",
        "skipUrlSync": false,
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "CraftHub — AI cost",
  "uid": "crafthub-ai-cost",
  "version": 1,
  "weekStart": ""
}
