node_modules
.pnp
.pnp.js

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# The production stack reads `.env.production` (see docker-compose.prod.yml).
# The list above matches `.env.production.local` but NOT `.env.production`, so
# without this line the file holding every production secret is a `git add -A`
# away from being committed. `.env.example` is the only env file that is
# tracked on purpose.
.env.production
!.env.example

